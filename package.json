{
  "name": "sngll-token",
  "version": "1.0.0",
  "private": true,
  "description": "SNGLL Token - ERC20 upgradeable (UUPS) en Polygon",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:amoy": "hardhat run scripts/deploy.js --network amoy",
    "deploy:polygon": "hardhat run scripts/deploy.js --network polygon",
    "upgrade:amoy": "hardhat run scripts/upgrade.js --network amoy",
    "upgrade:polygon": "hardhat run scripts/upgrade.js --network polygon",
    "roles:amoy": "hardhat run scripts/transferRoles.js --network amoy",
    "roles:polygon": "hardhat run scripts/transferRoles.js --network polygon",
    "governance:amoy": "hardhat run scripts/deployGovernance.js --network amoy",
    "governance:polygon": "hardhat run scripts/deployGovernance.js --network polygon"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/hardhat-upgrades": "^3.9.0",
    "dotenv": "^16.4.5",
    "hardhat": "^2.22.17"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.1.0",
    "@openzeppelin/contracts-upgradeable": "^5.1.0"
  }
}

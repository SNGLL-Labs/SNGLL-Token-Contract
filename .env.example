# === REDES ===
# Amoy (testnet) - por defecto en los scripts
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
# Polygon mainnet
POLYGON_RPC_URL=https://polygon-rpc.com

# === CUENTA DEPLOYER (wallet dedicada, con POL para gas) ===
PRIVATE_KEY=0xTU_CLAVE_PRIVADA

# === VERIFICACION (polygonscan.com -> API Keys) ===
ETHERSCAN_API_KEY=TU_API_KEY

# === PARAMETROS DEL initialize ===
# Si se omiten, se usa la direccion del deployer para los tres
RECIPIENT=0xDESTINATARIO_DEL_SUPPLY
DEFAULT_ADMIN=0xADMIN_DEL_TOKEN
UPGRADER=0xCUE_NTA_AUTORIZADA_A_UPGRADES

# === SOLO PARA upgrade.js ===
PROXY_ADDRESS=0xDIRECCION_DEL_PROXY
NEW_IMPLEMENTATION=SNGLLTokenV2

# === SOLO PARA transferRoles.js (handover a Safe) ===
SAFE_ADDRESS=0xTU_SAFE_MULTISIG
# Pon true SOLO cuando el Safe ya haya probado que puede ejecutar transacciones.
# Si es false, el script otorga los roles al Safe pero NO renuncia desde el EOA.
CONFIRM_RENOUNCE=false
